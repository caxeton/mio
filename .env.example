# URL de conexión de Neon (Postgres serverless).
# Formato: postgres://<user>:<password>@<host>/<dbname>?sslmode=require
# Obténla en https://console.neon.tech tras crear un proyecto.
DATABASE_URL=postgres://user:password@ep-example-000000.us-east-2.aws.neon.tech/devhub?sslmode=require

# Si DATABASE_URL no está definida, la app funciona igualmente con datos
# de ejemplo en memoria (ver lib/data.ts) para poder probar la interfaz.
