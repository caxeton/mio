{
  "name": "devhub",
  "version": "0.2.0",
  "private": true,
  "description": "Hub de Productividad para Desarrolladores - Dashboard estilo terminal para gestionar entornos Docker, pruebas de rendimiento de caché y snippets de código.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "db:setup": "node scripts/setup-db.mjs",
    "db:up": "docker compose up -d db",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
